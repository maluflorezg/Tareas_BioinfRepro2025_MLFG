# add col names
colnames(Fstmat)<- popNames
Fstmat
## Fix
x<-Fstmat
# add an extrarow
x <- rbind(x, n=NA)
# Change rownames to col names
rownames(x)<-colnames(x)
# add 0 diagonal
x[is.na(x)] <- 0
# make symmetrical matrix
x <- x + t(x)
Fstmat <-x
Fstmat
}
# add col names
